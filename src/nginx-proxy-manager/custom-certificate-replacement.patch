+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import EasyModal from "ez-modal-react";
+import { afterEach, expect, it, vi } from "vitest";
+import { showCustomCertificateModal } from "./CustomCertificateModal";
+
+afterEach(() => {
+	cleanup();
+	vi.unstubAllGlobals();
+});
+
+it("replaces the selected certificate without creating a record or sending a blank key", async () => {
+	const fetchMock = vi.fn().mockResolvedValue(new Response("{}"));
+	vi.stubGlobal("fetch", fetchMock);
+	render(
+		<QueryClientProvider client={new QueryClient()}>
+			<EasyModal.Provider />
+		</QueryClientProvider>,
+	);
+	await act(async () => {
+		showCustomCertificateModal({ id: 42, niceName: "shared wildcard" });
+	});
+	expect(await screen.findByDisplayValue("shared wildcard")).toHaveAttribute("readonly");
+	const certificate = new File(["renewed PEM"], "renewed.pem");
+	fireEvent.change(screen.getByLabelText("Certificate", { exact: true }), { target: { files: [certificate] } });
+	const form = screen.getByRole("button", { name: "Save" }).closest("form");
+	if (!form) throw new Error("Missing certificate form");
+	fireEvent.submit(form);
+	await waitFor(() => expect(fetchMock).toHaveBeenCalledOnce());
+	const [url, request] = fetchMock.mock.calls[0];
+	expect(url).toBe("/api/nginx/certificates/42/upload?replace_chain=true");
+	expect(request.body.get("certificate").name).toBe("renewed.pem");
+	expect(request.body.has("certificate_key")).toBe(false);
+});
