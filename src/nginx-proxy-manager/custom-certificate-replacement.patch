diff --git a/backend/internal/custom-certificate-files.js b/backend/internal/custom-certificate-files.js
new file mode 100644
index 0000000..0867641
--- /dev/null
+++ b/backend/internal/custom-certificate-files.js
@@ -0,0 +1,46 @@
+import fs from "node:fs";
+import path from "node:path";
+
+// Keep both original PEMs available until nginx and the database have accepted the upload.
+export async function withCustomCertificateFiles(dir, meta, apply, afterRestore) {
+	fs.mkdirSync(dir, { recursive: true });
+	const staging = fs.mkdtempSync(path.join(dir, ".upload-"));
+	const files = {
+		"fullchain.pem": [meta.certificate, meta.intermediate_certificate].filter(Boolean).join("\n"),
+		"privkey.pem": meta.certificate_key,
+	};
+	const installed = [];
+	let keepBackup = false;
+	try {
+		for (const [name, content] of Object.entries(files)) {
+			fs.writeFileSync(path.join(staging, name), content, { mode: 0o600 });
+		}
+		for (const name of Object.keys(files)) {
+			const live = path.join(dir, name);
+			const backup = path.join(staging, `${name}.old`);
+			const hadOriginal = fs.existsSync(live);
+			if (hadOriginal) {
+				fs.copyFileSync(live, backup);
+			}
+			fs.renameSync(path.join(staging, name), live);
+			installed.push({ live, backup, hadOriginal });
+		}
+		await apply();
+	} catch (err) {
+		keepBackup = true;
+		for (const { live, backup, hadOriginal } of installed.reverse()) {
+			if (hadOriginal) {
+				fs.renameSync(backup, live);
+			} else {
+				fs.unlinkSync(live);
+			}
+		}
+		keepBackup = false;
+		await afterRestore();
+		throw err;
+	} finally {
+		if (!keepBackup) {
+			fs.rmSync(staging, { recursive: true, force: true });
+		}
+	}
+}
