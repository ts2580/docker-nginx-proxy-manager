diff --git a/backend/test/custom-certificate-files.test.js b/backend/test/custom-certificate-files.test.js
new file mode 100644
index 0000000..65c1aa1
--- /dev/null
+++ b/backend/test/custom-certificate-files.test.js
@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { it } from "node:test";
+import { withCustomCertificateFiles } from "../internal/custom-certificate-files.js";
+
+it("restores both PEMs before recovering from a rejected replacement", async (t) => {
+	const dir = fs.mkdtempSync(path.join(os.tmpdir(), "npm-cert-test-"));
+	t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+	const read = (name) => fs.readFileSync(path.join(dir, name), "utf8");
+	fs.writeFileSync(path.join(dir, "fullchain.pem"), "original chain");
+	fs.writeFileSync(path.join(dir, "privkey.pem"), "original key");
+	let restored = false;
+	await assert.rejects(
+		withCustomCertificateFiles(
+			dir,
+			{ certificate: "new leaf", certificate_key: "new key", intermediate_certificate: "new intermediate" },
+			async () => {
+				assert.equal(read("fullchain.pem"), "new leaf\nnew intermediate");
+				assert.equal(read("privkey.pem"), "new key");
+				throw new Error("reload failed");
+			},
+			async () => {
+				assert.equal(read("fullchain.pem"), "original chain");
+				assert.equal(read("privkey.pem"), "original key");
+				restored = true;
+			},
+		),
+		/reload failed/,
+	);
+	assert.ok(restored);
+	assert.deepEqual(fs.readdirSync(dir).sort(), ["fullchain.pem", "privkey.pem"]);
+});
